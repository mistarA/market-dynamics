# Blob store (server-side only). Required for /api/refresh, /api/version and
# /api/index (lazy indices) in production.
BLOB_READ_WRITE_TOKEN=

# Locks /api/refresh. Vercel Cron sends it automatically as a bearer token.
CRON_SECRET=

# Public URL of snapshots/snapshot.json in Blob. Baked into the client at build.
# Local development falls back to /data/snapshot.json.
VITE_SNAPSHOT_URL=
